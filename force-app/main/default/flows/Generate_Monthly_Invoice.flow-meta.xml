<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Final_Amount</name>
        <label>Set Final Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>vFinalAmount</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fFinalAmount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Invoice</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Duplicate_Exists</name>
        <label>Duplicate Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_1_Review_Adjust</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Doesn&apos;t exist</defaultConnectorLabel>
        <rules>
            <name>Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Call_Validation_Flow.vExistingInvoiceId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_duplicate</targetReference>
            </connector>
            <label>Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Wizard_Permission</name>
        <label>Has Wizard Permission?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Intro</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Access</defaultConnectorLabel>
        <rules>
            <name>No_Access</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.ROPS_Use_Invoice_Wizard</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Access_Screen</targetReference>
            </connector>
            <label>No Access</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validation_Allowed</name>
        <label>Validation Allowed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Duplicate_Exists</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Allowed</defaultConnectorLabel>
        <rules>
            <name>Allowed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Call_Validation_Flow.vIsAllowed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Allowed</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fFinalAmount</name>
        <dataType>Number</dataType>
        <expression>IF({!Call_Validation_Flow.vAllowAmountOverride}, {!userAmount} , {!Call_Validation_Flow.vAmount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fInvoiceKey</name>
        <dataType>String</dataType>
        <expression>{!vNewInvoiceId}</expression>
    </formulas>
    <interviewLabel>Generate Monthly Invoice {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Generate Monthly Invoice</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Invoice</name>
        <label>Create Invoice</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>vNewInvoiceId</assignRecordIdToReference>
        <connector>
            <targetReference>Success</targetReference>
        </connector>
        <inputAssignments>
            <field>Amount__c</field>
            <value>
                <elementReference>fFinalAmount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DueDate__c</field>
            <value>
                <elementReference>Call_Validation_Flow.vDueDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Lease__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PeriodMonth__c</field>
            <value>
                <elementReference>Call_Validation_Flow.vPeriodMonth</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>Call_Validation_Flow.vInvoiceStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Invoice__c</object>
    </recordCreates>
    <runInMode>DefaultMode</runInMode>
    <screens>
        <name>Error_duplicate</name>
        <label>Error duplicate</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_duplicate_message</name>
            <fieldText>&lt;p&gt;{!$Label.ROPS_GenerateInvoice_Error_DuplicateInvoice}&lt;/p&gt;&lt;p&gt;&amp;lt;a href=&quot;/{!Call_Validation_Flow.vExistingInvoiceId}&quot; target=&quot;_blank&quot;&amp;gt;&lt;/p&gt;&lt;p&gt;{!$Label.ROPS_GenerateInvoice_OpenExisting}&lt;/p&gt;&lt;p&gt;&amp;lt;/a&amp;gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Intro</name>
        <label>Intro</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>Call_Validation_Flow</targetReference>
        </connector>
        <fields>
            <name>Title</name>
            <fieldText>&lt;p&gt;{!$Label.ROPS_GenerateInvoice_Title}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Lease_Id</name>
            <fieldText>&lt;p&gt;Lease: {!recordId}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>scrInvoiceDate</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>$Flow.CurrentDate</elementReference>
            </defaultValue>
            <fieldText>Invoice Date</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>No_Access_Screen</name>
        <label>No Access Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <fields>
            <name>Error_message</name>
            <fieldText>&lt;p&gt;{!$Label.ROPS_GenerateInvoice_NoAccess}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_1_Review_Adjust</name>
        <label>Screen 1 Review &amp; Adjust</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Final_Amount</targetReference>
        </connector>
        <fields>
            <name>Invoice_review</name>
            <fieldText>&lt;p&gt;Period Month: {!Call_Validation_Flow.vPeriodMonth}&lt;/p&gt;&lt;p&gt;Due Date: {!Call_Validation_Flow.vDueDate}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>userAmount</name>
            <dataType>Number</dataType>
            <defaultValue>
                <elementReference>Call_Validation_Flow.vAmount</elementReference>
            </defaultValue>
            <fieldText>Amount</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <scale>2</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;Amount must be greater than zero.&lt;/p&gt;</errorMessage>
                <formulaExpression>{!userAmount} &gt; 0</formulaExpression>
            </validationRule>
            <visibilityRule>
                <conditionLogic>1</conditionLogic>
                <conditions>
                    <leftValueReference>Call_Validation_Flow.vAllowAmountOverride</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <booleanValue>true</booleanValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Success</name>
        <label>Success</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Success_message</name>
            <fieldText>&lt;p&gt;{!$Label.ROPS_GenerateInvoice_Success}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&amp;lt;a href=&quot;/{!vNewInvoiceId}&quot; target=&quot;_blank&quot;&amp;gt;&lt;/p&gt;&lt;p&gt;Open Invoice&lt;/p&gt;&lt;p&gt;&amp;lt;/a&amp;gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Wizard_Permission</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_Validation_Flow</name>
        <label>Call Validation Flow</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Validation_Allowed</targetReference>
        </connector>
        <flowName>ROPS_ValidateAndResolveInvoice</flowName>
        <inputAssignments>
            <name>vInvoiceDate</name>
            <value>
                <elementReference>scrInvoiceDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vLeaseId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>vFinalAmount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>vNewInvoiceId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>

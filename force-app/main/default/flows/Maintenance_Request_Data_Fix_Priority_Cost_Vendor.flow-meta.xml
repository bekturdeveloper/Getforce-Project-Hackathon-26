<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>A1_Set_Priority_Emergency</name>
        <label>A1 - Set Priority Emergency</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Emergency</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>D2_Fix_cost_for_InProgress_Closed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>A2_Set_Cost_150</name>
        <label>A2 - Set Cost 150</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.CostEstimate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>150.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>D3_Closed_vendor_missing</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>A3_Set_Cost_150</name>
        <label>A3 - Set Cost 150</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.CostEstimate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>150.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>D3_Closed_vendor_missing</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>A4_Set_Cost_150</name>
        <label>A4 - Set Cost 150</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.CostEstimate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>150.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>D3_Closed_vendor_missing</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>A5_Set_Cost_150</name>
        <label>A5 - Set Cost 150</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.CostEstimate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>150.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>D3_Closed_vendor_missing</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>As_Set_Vendor_FisIt_Pro</name>
        <label>As - Set Vendor FisIt Pro</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.VendorName__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>FixIt Pro</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>U1_Update_Maintenance_Request</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>D1_New_older_than_7_days</name>
        <label>D1 - New older than 7 days?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>D2_Fix_cost_for_InProgress_Closed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Set_Emergency</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RequestedAt__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>dt7DaysAgo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A1_Set_Priority_Emergency</targetReference>
            </connector>
            <label>Yes - Set Emergency</label>
        </rules>
    </decisions>
    <decisions>
        <name>D2_Fix_cost_for_InProgress_Closed</name>
        <label>D2 - Fix cost for InProgress/Closed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>D3_Closed_vendor_missing</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Set_Cost_150</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>InProgress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CostEstimate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A2_Set_Cost_150</targetReference>
            </connector>
            <label>Yes - Set Cost = 150</label>
        </rules>
        <rules>
            <name>Yes_InProgress_Cost_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>InProgress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CostEstimate__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A3_Set_Cost_150</targetReference>
            </connector>
            <label>Yes-InProgress Cost = 0</label>
        </rules>
        <rules>
            <name>Yes_Closed_Cost_is_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CostEstimate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A4_Set_Cost_150</targetReference>
            </connector>
            <label>Yes - Closed Cost is Null</label>
        </rules>
        <rules>
            <name>Yes_Closed_Cost_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CostEstimate__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>A5_Set_Cost_150</targetReference>
            </connector>
            <label>Yes - Closed Cost = 0</label>
        </rules>
    </decisions>
    <decisions>
        <name>D3_Closed_vendor_missing</name>
        <label>D3 - Closed vendor missing?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Set_Vendor_FixIt_Pro</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.VendorName__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>As_Set_Vendor_FisIt_Pro</targetReference>
            </connector>
            <label>Yes - Set Vendor FixIt Pro</label>
        </rules>
    </decisions>
    <description>Scheduled flow to fix MaintenanceRequest__c backlog:

Set Priority__c = Emergency for New requests older than 7 days

Set CostEstimate__c = 150 for InProgress/Closed requests where cost is blank or 0

Set VendorName__c = FixIt Pro for Closed requests where vendor is blank
Runs in UAT first, then deployed to PROD with evidence (counts + samples).</description>
    <environments>Default</environments>
    <formulas>
        <name>dt7DaysAgo</name>
        <dataType>DateTime</dataType>
        <expression>$Flow.CurrentDateTime - 7</expression>
    </formulas>
    <interviewLabel>Maintenance Request Data Fix (Priority, Cost, Vendor) {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Maintenance Request Data Fix (Priority, Cost, Vendor)</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>U1_Update_Maintenance_Request</name>
        <label>U1 - Update Maintenance Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>D1_New_older_than_7_days</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>New</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>InProgress</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <object>MaintenanceRequest__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-02-13</startDate>
            <startTime>02:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>

        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varTotalPaid</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Completed_Payments.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Completed_Payments</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <name>Show_Error</name>
        <label>Show Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>{!$Label.ROPS_PaymentAmountExceedsOutstanding_Error}</errorMessage>
            <fieldSelection>Amount__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Check_Overpayment</name>
        <label>Check Overpayment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>overpaid</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Amount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>formRemaining</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Error</targetReference>
            </connector>
            <label>overpaid</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formRemaining</name>

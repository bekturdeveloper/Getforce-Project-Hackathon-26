    <decisions>
        <name>Deposit_Validation</name>
        <label>Deposit Validation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Depo_required</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lease_Finance_Policy.RequireDeposit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.DepositAmount__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DepositAmount__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Depo_error</targetReference>
            </connector>
            <label>Depo required</label>
        </rules>
        <rules>
            <name>Outcome_2_of_Deposit_Validation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.MonthlyRent__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lease_Finance_Policy.MinDepositMonths__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lease_Finance_Policy.MinDepositMonths__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>MinDeposit</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DepositAmount__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>MinDeposit</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Min_dep_error</targetReference>
            </connector>
            <label>Outcome 2 of Deposit Validation</label>
        </rules>
        <rules>
            <name>Outcome_3_of_Deposit_Validation</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lease_Finance_Policy.MaxDepositMonths__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lease_Finance_Policy.MaxDepositMonths__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>MaxDeposit1</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DepositAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Lease_Finance_Policy.MaxDepositMonths__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Max_depo_error</targetReference>
            </connector>
            <label>Outcome 3 of Deposit Validation</label>
        </rules>
    </decisions>

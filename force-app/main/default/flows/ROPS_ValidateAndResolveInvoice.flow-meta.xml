        <defaultConnector>
            <targetReference>Assign_Period_Month</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>In Range</defaultConnectorLabel>
        <rules>
            <name>Out_of_Range</name>
            <conditionLogic>1 OR 2</conditionLogic>
            <conditions>
                <leftValueReference>vInvoiceDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Get_Lease.StartDate__c</elementReference>

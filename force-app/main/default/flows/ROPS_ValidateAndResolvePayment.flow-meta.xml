            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Validation_Checks</name>
        <label>Validation Checks</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Existing_Payment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All Checks Passed</defaultConnectorLabel>
        <rules>
            <name>Wizard_Disabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_RenterOps_Settings.Enable_Payment_Wizard__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Error_Wizard_Disabled</targetReference>
            </connector>
            <label>Wizard Disabled</label>
        </rules>
        <rules>
            <name>Invoice_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vInvoiceRecordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Error_Invoice_Missing</targetReference>
            </connector>
            <label>Invoice Missing</label>
        </rules>
        <rules>
            <name>Invalid_Amount</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vPaymentAmount</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Error_Invalid_Amount</targetReference>
            </connector>
            <label>Invalid Amount</label>
        </rules>
        <rules>
            <name>Overpayment_Not_Allowed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_RenterOps_Settings.Allow_Overpayment__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>vPaymentAmount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Invoice.Amount__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Error_Overpayment</targetReference>
            </connector>
            <label>Overpayment Not Allowed</label>
        </rules>
    </decisions>

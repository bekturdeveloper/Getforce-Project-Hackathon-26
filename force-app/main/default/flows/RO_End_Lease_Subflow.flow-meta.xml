        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Related_Asset.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AvailabilityStatus__c</field>
            <value>
                <stringValue>Vacant</stringValue>
            </value>
        </inputAssignments>
        <object>RentalAsset__c</object>
    </recordUpdates>

<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Output_Lease_Id</name>
        <label>Set Output Lease Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outLeaseId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Lease.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Active_Lease_Exists</name>
        <label>Check Active Lease Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Lease</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Has_Active_Lease_BLOCK</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Lease.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Has_Active_Lease (BLOCK)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Asset_Is_Vacant</name>
        <label>Check Asset Is Vacant</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Active_Lease</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Vacant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Rental_Asset.AvailabilityStatus__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Vacant</stringValue>
                </rightValue>
            </conditions>
            <label>Not_Vacant</label>
        </rules>
    </decisions>
    <description>Handles backend logic for starting a lease from a Rental Asset.
Performs guard checks (asset must be Vacant, no Active Lease exists),
creates the Lease record, updates the Rental Asset status to Occupied,
and returns the created Lease Id to the calling Screen Flow.</description>
    <environments>Default</environments>
    <interviewLabel>RO_StartLease_Subflow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RO_StartLease_Subflow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Lease</name>
        <label>Create Lease</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>

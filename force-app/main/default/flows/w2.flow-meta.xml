            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_User_Permission</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Validate_Payment_and_Resolve_Policy</name>
        <label>Validate Payment and Resolve Policy</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Payment_Valid</targetReference>
        </connector>
        <flowName>ROPS_ValidateAndResolvePayment</flowName>
        <inputAssignments>
            <name>vInvoiceRecordId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vPaymentAmount</name>
            <value>
                <elementReference>Payment_Amount_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vPaymentDate</name>
            <value>
                <elementReference>Payment_Date_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>vPaymentMethod</name>
            <value>
                <elementReference>Payment_Method_Input</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>

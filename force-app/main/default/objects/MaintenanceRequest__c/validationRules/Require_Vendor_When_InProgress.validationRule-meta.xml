<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Vendor_When_InProgress</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;InProgress&quot;),
    ISBLANK(VendorName__c)
)</errorConditionFormula>
    <errorDisplayField>VendorName__c</errorDisplayField>
    <errorMessage>Vendor Name is required when Maintenance Request status is In Progress.</errorMessage>
</ValidationRule>
